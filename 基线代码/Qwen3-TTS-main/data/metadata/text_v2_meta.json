[
  {
    "new_id": "000001",
    "biaobei_id": "002020",
    "text": "麦克总是以各种理由推脱。"
  },
  {
    "new_id": "000002",
    "biaobei_id": "006632",
    "text": "张蕊说，外公还特别喜欢逛街，经常到春熙路逛。"
  },
  {
    "new_id": "000003",
    "biaobei_id": "007452",
    "text": "这个网吧位于凯里市清平南路一个桥洞之下。"
  },
  {
    "new_id": "000004",
    "biaobei_id": "006059",
    "text": "生物柴油公司，收购的就是这种油。"
  },
  {
    "new_id": "000005",
    "biaobei_id": "001830",
    "text": "日前，利辛县望疃镇农民在浇灌麦田。"
  },
  {
    "new_id": "000006",
    "biaobei_id": "009384",
    "text": "就哄着乐乐，乐乐也安静下来了，并没有出现任何症状。"
  },
  {
    "new_id": "000007",
    "biaobei_id": "006253",
    "text": "在他看来，现在首要问题是怎么保存牛黄。"
  },
  {
    "new_id": "000008",
    "biaobei_id": "002571",
    "text": "越深的海底生物就越少哦！"
  },
  {
    "new_id": "000009",
    "biaobei_id": "007039",
    "text": "但按这个说法，张雨绮立刻从“被甩方”变成了“劈腿方”。"
  },
  {
    "new_id": "000010",
    "biaobei_id": "002231",
    "text": "量化考核、薪酬与业绩挂钩的机制。"
  },
  {
    "new_id": "000011",
    "biaobei_id": "004824",
    "text": "雅典称王的韩国小子柳承敏有望创造历史吗？"
  },
  {
    "new_id": "000012",
    "biaobei_id": "003270",
    "text": "到偏桥底村看了后，情况还不是这样。"
  },
  {
    "new_id": "000013",
    "biaobei_id": "004995",
    "text": "我是大方温柔的巨蟹座，有时候也会有点敏感和脆弱。"
  },
  {
    "new_id": "000014",
    "biaobei_id": "005414",
    "text": "山东省招远市市委书记徐少宁，就是他们的突出代表。"
  },
  {
    "new_id": "000015",
    "biaobei_id": "005237",
    "text": "能不能让不同时产的甲鱼卵同时孵化出壳呢？"
  },
  {
    "new_id": "000016",
    "biaobei_id": "002674",
    "text": "农民工于占水称，这老农民挣俩钱也真不易呀，这也不给呀。"
  },
  {
    "new_id": "000017",
    "biaobei_id": "007431",
    "text": "风险也是浪漫的一部分吗？"
  },
  {
    "new_id": "000018",
    "biaobei_id": "004697",
    "text": "其中，大部分随迁子女面临高考难题。"
  },
  {
    "new_id": "000019",
    "biaobei_id": "002725",
    "text": "全市继续推进爱国卫生运动，大力开展灭蚊工作。"
  },
  {
    "new_id": "000020",
    "biaobei_id": "009224",
    "text": "他只称太太亦很信任他。"
  },
  {
    "new_id": "000021",
    "biaobei_id": "001708",
    "text": "甘迪勒没有说明这些示威者由哪方收买。"
  },
  {
    "new_id": "000022",
    "biaobei_id": "007222",
    "text": "摄影师没有手，就像赛跑者没有脚，令人气馁。"
  },
  {
    "new_id": "000023",
    "biaobei_id": "009935",
    "text": "咪咪舔着孩子，把它身上的毛舔干净。"
  },
  {
    "new_id": "000024",
    "biaobei_id": "005797",
    "text": "罗天诚低声说深沉是无法伪装的。"
  },
  {
    "new_id": "000025",
    "biaobei_id": "001699",
    "text": "法院调查表明，被砍死的医生并未接诊过凶手。"
  },
  {
    "new_id": "000026",
    "biaobei_id": "007227",
    "text": "随后男子竟在众目睽睽之下吮吸鸵鸟血液。"
  },
  {
    "new_id": "000027",
    "biaobei_id": "001132",
    "text": "同年，普洱冷水林场采伐开工。"
  },
  {
    "new_id": "000028",
    "biaobei_id": "003490",
    "text": "林欣彤频频吸金，笑到眼睛都眯起来。"
  },
  {
    "new_id": "000029",
    "biaobei_id": "007663",
    "text": "回万岁，包拯不就在这儿吗？八贤王指着不知所措的包拯道。"
  },
  {
    "new_id": "000030",
    "biaobei_id": "002705",
    "text": "能否重现亚特兰大奥运会上的辉煌？"
  },
  {
    "new_id": "000031",
    "biaobei_id": "009560",
    "text": "对于反对派，我一直觉得他们很肮脏。"
  },
  {
    "new_id": "000032",
    "biaobei_id": "003900",
    "text": "跑了三十多米自己也熏到了。"
  },
  {
    "new_id": "000033",
    "biaobei_id": "005014",
    "text": "他还表示，贝卢斯科尼这个“傀儡必须滚蛋”。"
  },
  {
    "new_id": "000034",
    "biaobei_id": "007686",
    "text": "作为小舅子的我去劝架，果然有用！"
  },
  {
    "new_id": "000035",
    "biaobei_id": "000648",
    "text": "楼市降价的豁口未现，但暗流已经汹涌。"
  },
  {
    "new_id": "000036",
    "biaobei_id": "002814",
    "text": "也会在纽约逛逛，看看衣服。"
  },
  {
    "new_id": "000037",
    "biaobei_id": "007640",
    "text": "有时在商圈请个棒棒都难。"
  },
  {
    "new_id": "000038",
    "biaobei_id": "007523",
    "text": "他先向我丢过一个飞吻来，如果不把它丢回去，难道您还让我留着它不成？"
  },
  {
    "new_id": "000039",
    "biaobei_id": "002829",
    "text": "拨了一上午，头寸还没谱。"
  },
  {
    "new_id": "000040",
    "biaobei_id": "005530",
    "text": "你银行卡里竟然还有钱？"
  },
  {
    "new_id": "000041",
    "biaobei_id": "002711",
    "text": "一个周六，“张某”邀请武某一起出来玩。"
  },
  {
    "new_id": "000042",
    "biaobei_id": "009645",
    "text": "快人快语是李永波的个性。"
  },
  {
    "new_id": "000043",
    "biaobei_id": "001885",
    "text": "当然帅啦，在我心中你又帅又酷。"
  },
  {
    "new_id": "000044",
    "biaobei_id": "005651",
    "text": "这是俄罗斯历史上伤亡最惨重的潜艇事故。"
  },
  {
    "new_id": "000045",
    "biaobei_id": "008386",
    "text": "我当时还脑残的说：怎么是软的？"
  },
  {
    "new_id": "000046",
    "biaobei_id": "002179",
    "text": "巨星陨落，举国悲痛。"
  },
  {
    "new_id": "000047",
    "biaobei_id": "004270",
    "text": "互联网正润物细无声地影响中国社会。"
  },
  {
    "new_id": "000048",
    "biaobei_id": "001906",
    "text": "尽管字体歪歪斜斜，但句句饱含深情。"
  },
  {
    "new_id": "000049",
    "biaobei_id": "007824",
    "text": "蔡少芬昨日出席活动，身材明显已回复苗条状态。"
  },
  {
    "new_id": "000050",
    "biaobei_id": "004963",
    "text": "抹布也是很有用的哟！"
  },
  {
    "new_id": "000051",
    "biaobei_id": "001371",
    "text": "基于陈某平日横行霸道，蛮横无理，一直忍气吞声，敢怒不敢言。"
  },
  {
    "new_id": "000052",
    "biaobei_id": "008169",
    "text": "唯伤心天公不作美，英雄或许要承受多磨难！"
  },
  {
    "new_id": "000053",
    "biaobei_id": "007954",
    "text": "祖国大地何愁不早日披上绿妆呢？"
  },
  {
    "new_id": "000054",
    "biaobei_id": "003766",
    "text": "勾机开进村，全面拆除走私旧服装窝棚门店。"
  },
  {
    "new_id": "000055",
    "biaobei_id": "001551",
    "text": "我会学小猫叫哦，喵！"
  },
  {
    "new_id": "000056",
    "biaobei_id": "002057",
    "text": "还有对体弱儿进行专案管理。"
  },
  {
    "new_id": "000057",
    "biaobei_id": "008829",
    "text": "这不符合政策规定，应予查处纠正。"
  },
  {
    "new_id": "000058",
    "biaobei_id": "000662",
    "text": "她倒下了，我姑父和我外甥可怎么办呀！"
  },
  {
    "new_id": "000059",
    "biaobei_id": "006087",
    "text": "别离开我！我会努力变聪明的！"
  },
  {
    "new_id": "000060",
    "biaobei_id": "009572",
    "text": "有什么心事吗？可以和我分享一下呀。"
  },
  {
    "new_id": "000061",
    "biaobei_id": "003727",
    "text": "尽管奶源有限，我国乳业现状却是企业数量较多且参差不齐。"
  },
  {
    "new_id": "000062",
    "biaobei_id": "005373",
    "text": "据悉，该银行目前在深圳已经全面停做房贷业务。"
  },
  {
    "new_id": "000063",
    "biaobei_id": "009806",
    "text": "观众总会有新宠，不复念旧人。"
  },
  {
    "new_id": "000064",
    "biaobei_id": "009942",
    "text": "传闻越来越多，后来连老汉儿自己都怕了。"
  },
  {
    "new_id": "000065",
    "biaobei_id": "006071",
    "text": "说明管理部门怕得罪人，不敢碰硬。"
  },
  {
    "new_id": "000066",
    "biaobei_id": "006919",
    "text": "在喀什老城区，张春贤来到馕摊儿前、走进居民中。"
  },
  {
    "new_id": "000067",
    "biaobei_id": "009899",
    "text": "每一个“火箭官”都顺利地升上去了，冉冉若星光。"
  },
  {
    "new_id": "000068",
    "biaobei_id": "002657",
    "text": "还让我赤裸着上身唱歌。"
  },
  {
    "new_id": "000069",
    "biaobei_id": "005446",
    "text": "该男子被指密云县政协委员李昕旸。"
  },
  {
    "new_id": "000070",
    "biaobei_id": "000294",
    "text": "其余的是斑胸草雀和枫鸟等种类。"
  },
  {
    "new_id": "000071",
    "biaobei_id": "004439",
    "text": "再过几天子孙们就要回来过年了，我家这个年咋个过哦。"
  },
  {
    "new_id": "000072",
    "biaobei_id": "002154",
    "text": "足见孟暖儿的演艺发展潜力有多么宽广。"
  },
  {
    "new_id": "000073",
    "biaobei_id": "008417",
    "text": "距今约四千五百年，是巴人发祥地遗址。"
  },
  {
    "new_id": "000074",
    "biaobei_id": "005636",
    "text": "现在成了危房，我一大家子人怎么办哟。"
  },
  {
    "new_id": "000075",
    "biaobei_id": "003010",
    "text": "叔祝福妞永远幸福快乐。"
  },
  {
    "new_id": "000076",
    "biaobei_id": "005638",
    "text": "根据质地我们可以看到分若干个品种。"
  },
  {
    "new_id": "000077",
    "biaobei_id": "003370",
    "text": "刚才听课文录音太困了，眯一下，就算是休息。"
  },
  {
    "new_id": "000078",
    "biaobei_id": "004582",
    "text": "财政政策应当发挥更为关键性作用。"
  },
  {
    "new_id": "000079",
    "biaobei_id": "006695",
    "text": "国务院的深切关怀送到亲人的心坎上。"
  },
  {
    "new_id": "000080",
    "biaobei_id": "003827",
    "text": "父亲说他无钱为儿操办婚事，打算去卖肾。"
  },
  {
    "new_id": "000081",
    "biaobei_id": "002871",
    "text": "图为“调查团”船只绕岛航行。"
  },
  {
    "new_id": "000082",
    "biaobei_id": "004464",
    "text": "熊成在深圳海滩玩耍。"
  },
  {
    "new_id": "000083",
    "biaobei_id": "003142",
    "text": "断不准官吏胥役藉词禁令扰累名间。"
  },
  {
    "new_id": "000084",
    "biaobei_id": "004659",
    "text": "当手部明显肮脏时，用肥皂和流水清洗。"
  },
  {
    "new_id": "000085",
    "biaobei_id": "000661",
    "text": "为撺掇新郎新娘做游戏，朋友们围挤在床边起哄。"
  },
  {
    "new_id": "000086",
    "biaobei_id": "004800",
    "text": "老太太撇头观望，已经注意到银灰色轿车高速驶来。"
  },
  {
    "new_id": "000087",
    "biaobei_id": "000980",
    "text": "森本敏在会谈中仅表示“将认真对待决议”。"
  },
  {
    "new_id": "000088",
    "biaobei_id": "002326",
    "text": "又何谈抗衡更加凶残的外来入侵者？"
  },
  {
    "new_id": "000089",
    "biaobei_id": "009945",
    "text": "显然，“洛阳性奴”案不具备上述两个前提。"
  },
  {
    "new_id": "000090",
    "biaobei_id": "009669",
    "text": "网民们是否普遍受到过流氓软件的骚扰呢？"
  },
  {
    "new_id": "000091",
    "biaobei_id": "009414",
    "text": "历史，靠遵化人的热血和汗水写就。"
  },
  {
    "new_id": "000092",
    "biaobei_id": "009151",
    "text": "当然是忙着学习变得更棒喽。"
  },
  {
    "new_id": "000093",
    "biaobei_id": "005703",
    "text": "今天外面的天气挺冷的，但一进校园，就感觉暖暖的。"
  },
  {
    "new_id": "000094",
    "biaobei_id": "004318",
    "text": "孙辉恨不得要说：老子学富五车，你够资格要我指正吗！"
  },
  {
    "new_id": "000095",
    "biaobei_id": "000530",
    "text": "宫小村拐儿乞讨的网文发表后，引起轩然大波。"
  },
  {
    "new_id": "000096",
    "biaobei_id": "008518",
    "text": "是抠还是大方，那要分是什么事儿。"
  },
  {
    "new_id": "000097",
    "biaobei_id": "007715",
    "text": "这时，韩某和贺某便凑上来，哄骗李某说愿意帮她找回皮包。"
  },
  {
    "new_id": "000098",
    "biaobei_id": "009803",
    "text": "经区政府与多方协调，重新上路。"
  },
  {
    "new_id": "000099",
    "biaobei_id": "003746",
    "text": "外界熟知的老故事是，哪怕买把扫帚，都得宗庆后批准。"
  },
  {
    "new_id": "000100",
    "biaobei_id": "002470",
    "text": "岁月荏苒，人生易老。"
  }
]