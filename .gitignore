# =============================================================================
# Qwen3-TTS 课题项目 — 生成文件 / 音频数据 / 模型缓存
# =============================================================================

# ── macOS 系统文件 ───────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDE / 编辑器 ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/

# ── 音频数据 ───────────────────────────────────────────────────────────────────
# 原始录音 + 转换产物均保留
# 预处理 + 增强 不提交
**/data/wavs_clean/
**/data/wavs_v2_clean/
**/data/wavs_augmented/
**/data/wavs_v2_augmented/

# ── Pipeline 生成文件 ─────────────────────────────────────────────────────────
# 实验分组 JSONL
**/data/experiments/

# 质检 + 预处理 + 增强报告
**/data/reports/

# 自动生成的 ID 列表
**/data/metadata/top50_ids*.txt

# 训练 _with_codes JSONL（体积大，含离散编码，不提交）
**/train_with_codes.jsonl

# ── SFT 训练产物 ──────────────────────────────────────────────────────────────
# checkpoint 体积巨大，不上传
**/checkpoint-epoch-*/
**/checkpoints/
output/

# ── 推理测试生成音频 ──────────────────────────────────────────────────────────
clone_output_*.wav
*.wav.tmp
tmp*.wav
test_output*.wav

# ── 评测生成文件 ──────────────────────────────────────────────────────────────
**/evaluation/results/
**/evaluation/data/enrollment/*.wav
**/evaluation/data/generated/zero_shot/*.wav
**/evaluation/data/generated/sft/*.wav

# ── 训练日志 ──────────────────────────────────────────────────────────────────
logs/
tensorboard/
runs/
*.log

# ── 模型缓存（由 HuggingFace / ModelScope 自动下载，体积巨大）───────────────
~/.cache/huggingface/
~/.cache/modelscope/
*.h5
*.ckpt
*.pth

# ── 临时脚本 / 调试文件 ───────────────────────────────────────────────────────
# 一次性测试脚本，勿提交
run_clone_test.py
scratch/
tmp/
temp/
debug_*.py

